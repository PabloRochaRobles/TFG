# Plantilla de variables de entorno del backend.
# Copia este fichero como `.env` y rellena con tus valores reales.
# El `.env` real NO se sube a git.

# Generar con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-aleatoria-larga

# true en desarrollo local; false en producción (sin tracebacks al cliente).
DJANGO_DEBUG=true

# Hosts separados por comas. Para producción añadir el dominio del tunnel.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
